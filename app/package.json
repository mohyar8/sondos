{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.2.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:cinematic": "node scripts/build-design.mjs cinematic",
    "build:classic": "node scripts/build-design.mjs classic",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --import ./tests/setup/no-network.mjs --import ./tests/setup/resolve-ts.mjs --test \"tests/**/*.test.mjs\"",
    "verify": "node scripts/verify.mjs",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/el-messiri": "^5.3.0",
    "firebase": "^12.17.1",
    "jose": "^6.2.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.0",
    "@cloudflare/workers-types": "^5.20260819.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "sharp": "^0.35.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "wrangler": "^4.124.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true,
    "@firebase/util@1.15.2": true,
    "protobufjs@7.6.5": true
  }
}
